+base::TimeDelta SpdySessionPool::MinTransportRttTo(
+    const HostPortPair& server) const {
+  base::TimeDelta result;
+  for (SpdySession* session : sessions_) {
+    base::TimeDelta smoothed_rtt, min_rtt;
+    if (session->host_port_pair() != server ||
+        !session->GetTransportRttInfo(&smoothed_rtt, &min_rtt)) {
+      continue;
+    }
+    if (result.is_zero() || min_rtt < result) {
+      result = min_rtt;
+    }
+  }
+  return result;
+}
