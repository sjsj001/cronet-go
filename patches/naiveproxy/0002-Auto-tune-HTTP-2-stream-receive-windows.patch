+void SpdyStream::MaybeGrowRecvWindow() {
+  const base::TimeTicks now = base::TimeTicks::Now();
+  const base::TimeTicks previous = last_window_limited_update_;
+  last_window_limited_update_ = now;
+  const bool previous_fast = last_window_limited_update_fast_;
+  last_window_limited_update_fast_ = false;
+  const int32_t cap = session_->stream_recv_window_cap();
+  if (previous.is_null() || max_recv_window_size_ >= cap) {
+    return;
+  }
+  base::TimeDelta smoothed_rtt, min_rtt;
+  if (!session_->GetTransportRttInfo(&smoothed_rtt, &min_rtt)) {
+    return;
+  }
+  // QUIC's rule (QuicFlowController::MaybeIncreaseMaxWindowSize): half the
+  // window consumed again within two round trips means the sender ran out of
+  // window rather than of data. A reader slower than the path never meets it,
+  // so its window, and the memory a fast sender can fill behind it, stays
+  // small.
+  if (now - previous >= 2 * smoothed_rtt) {
+    return;
+  }
+  // Twice in a row, unlike QUIC: on a relay the hop downstream takes about a
+  // window at once whatever its own reader does (another naive client's 8MB
+  // stream window, a socket's buffers), which is two such updates in quick
+  // succession from a reader that then stalls. One that keeps up makes the
+  // third.
+  last_window_limited_update_fast_ = true;
+  if (!previous_fast) {
+    return;
+  }
+  // QUIC can leave the queue to its own congestion control; this window is
+  // the only thing bounding what a relay keeps in flight, and on a path whose
+  // bottleneck already queues, the smoothed RTT grows with the window and the
+  // rule above would hold all the way to the cap. A smoothed RTT well above
+  // the minimum is that queue: the window stays where it is.
+  if (smoothed_rtt * 2 > min_rtt * 3) {
+    return;
+  }
+  const int32_t grown = static_cast<int32_t>(
+      std::min<int64_t>(int64_t{max_recv_window_size_} * 2, cap));
+  const int32_t delta = grown - max_recv_window_size_;
+  max_recv_window_size_ = grown;
+  // The doubled window proves itself again before the next doubling.
+  last_window_limited_update_fast_ = false;
+  recv_window_size_ += delta;
+  unacked_recv_window_bytes_ += delta;
+  net_log_.AddEvent(NetLogEventType::HTTP2_STREAM_UPDATE_RECV_WINDOW, [&] {
+    return NetLogSpdyStreamWindowUpdateParams(stream_id_, delta,
+                                              recv_window_size_);
+  });
+}
