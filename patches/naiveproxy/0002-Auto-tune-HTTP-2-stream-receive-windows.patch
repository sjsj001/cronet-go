+  // Auto-tuning starts every stream small and grows it on measurement, so it
+  // needs a transport that can measure: over one that cannot report its RTT
+  // (a socket pair, a platform without TCP_INFO), a stream would stay at the
+  // initial window for good, and the configured one is announced as before.
+  // A session opened while the path already queues measures that queue in
+  // its handshake (seconds behind a saturated slow link), and a window sized
+  // on it would add to the queue; the other sessions to this server carry
+  // the path's minimum over the kernel's window (tcp_min_rtt_wlen, 300s), so
+  // the smaller of the two is the path. With no other session, a cold start
+  // behind a queue still sizes on what it measured.
+  base::TimeDelta smoothed_rtt, min_rtt;
+  if (stream_recv_window_auto_tuning_ &&
+      GetTransportRttInfo(&smoothed_rtt, &min_rtt)) {
+    const base::TimeDelta path_rtt =
+        pool_min_rtt_.is_positive() ? std::min(smoothed_rtt, pool_min_rtt_)
+                                    : smoothed_rtt;
+    const int64_t initial = std::max<int64_t>(
+        kAutoTunedInitialStreamWindowFloor,
+        kAutoTunedInitialRate * path_rtt.InMicroseconds() / 1000000);
+    if (initial < stream_max_recv_window_size_) {
+      stream_recv_window_cap_ = stream_max_recv_window_size_;
+      stream_max_recv_window_size_ = static_cast<int32_t>(initial);
+      settings_map[spdy::SETTINGS_INITIAL_WINDOW_SIZE] =
+          stream_max_recv_window_size_;
+    }
+  }
   if (enable_http2_settings_grease_) {
     spdy::SpdySettingsId greased_id = 0x0a0a +
                                       0x1000 * base::RandGenerator(0xf + 1) +
