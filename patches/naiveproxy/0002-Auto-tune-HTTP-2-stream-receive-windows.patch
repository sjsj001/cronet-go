+namespace {
+// The window a stream starts with when auto-tuning is what a stream needs to
+// run at kAutoTunedInitialRate over this session's RTT, never less than
+// kAutoTunedInitialStreamWindowFloor: a stream on a fresh session must reach a
+// gigabit at once, with a fifth to spare (1200Mbit/s), rather than ramp up
+// to it. The floor covers what the transport's RTT does not see — a local
+// hop whose consumer takes milliseconds to read, where the RTT is tens of
+// microseconds and the growth rule never fires.
+constexpr int64_t kAutoTunedInitialRate = 1200 * 1000 * 1000 / 8;  // bytes/s
+constexpr int32_t kAutoTunedInitialStreamWindowFloor = 8 * 1024 * 1024;
+}  // namespace
+
+bool SpdySession::GetTransportRttInfo(base::TimeDelta* smoothed_rtt,
