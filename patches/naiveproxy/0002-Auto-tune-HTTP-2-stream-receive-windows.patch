 #endif  // defined(TCP_INFO)
 }
 
+#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS) || BUILDFLAG(IS_ANDROID)
+namespace {
+// The kernel's struct tcp_info up to tcpi_min_rtt. The libc headers in the
+// sysroots stop short of it, and the kernel's layout only ever grows at the
+// end, so the prefix is declared here.
+struct KernelTcpInfoPrefix {
+  uint8_t state, ca_state, retransmits, probes, backoff, options, wscale,
+      flags;
+  uint32_t rto, ato, snd_mss, rcv_mss, unacked, sacked, lost, retrans, fackets;
+  uint32_t last_data_sent, last_ack_sent, last_data_recv, last_ack_recv;
+  uint32_t pmtu, rcv_ssthresh, rtt, rttvar, snd_ssthresh, snd_cwnd, advmss,
+      reordering;
+  uint32_t rcv_rtt, rcv_space, total_retrans;
+  uint64_t pacing_rate, max_pacing_rate, bytes_acked, bytes_received;
+  uint32_t segs_out, segs_in, notsent_bytes, min_rtt;
+};
+static_assert(offsetof(KernelTcpInfoPrefix, min_rtt) == 148,
+              "struct tcp_info layout");
+}  // namespace
+#endif
+
+bool TCPSocketPosix::GetTransportRttInfo(base::TimeDelta* smoothed_rtt,
+                                         base::TimeDelta* min_rtt) const {
+#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS) || BUILDFLAG(IS_ANDROID)
+  if (!socket_) {
+    return false;
+  }
+  KernelTcpInfoPrefix info = {};
+  socklen_t info_len = sizeof(info);
+  if (getsockopt(socket_->socket_fd(), IPPROTO_TCP, TCP_INFO, &info,
+                 &info_len) != 0 ||
+      info_len < sizeof(info)) {
+    return false;
+  }
+  // tcpi_min_rtt is ~0U until the first RTT sample, and the kernel never
+  // records a sample of 0. tcpi_rtt rounds down to whole microseconds and can
+  // read 0 on loopback; as in GetTransportRtt, that is a microsecond.
+  if (info.min_rtt == 0 || info.min_rtt == ~0U) {
+    return false;
+  }
+  *smoothed_rtt = base::Microseconds(std::max<uint32_t>(info.rtt, 1));
+  *min_rtt = base::Microseconds(info.min_rtt);
+  return true;
+#else
+  return false;
+#endif
+}
